#!/usr/bin/env bash
# git credential helper: answers github.com requests with an agent token for the requested repo.
# Needs credential.useHttpPath=true, otherwise git sends no path. See docs/containers.md.
set -euo pipefail
[[ ${1:-} == get ]] || exit 0 # store/erase: the token cache lives in agent-token
while IFS='=' read -r key value && [[ -n $key ]]; do
  case $key in
    host) host=$value ;;
    path) path=${value%.git} ;;
  esac
done
# Stay silent for other hosts so git falls through to the next helper.
[[ ${host:-} == github.com && ${path:-} == */* ]] || exit 0
# quit: on failure, later helpers (e.g. one forwarding your own login) must not answer instead.
token=$(AGENT_TOKEN_NONINTERACTIVE=1 agent-token "$path") || { echo quit=1; exit 0; }
printf 'username=x-access-token\npassword=%s\n' "$token"
